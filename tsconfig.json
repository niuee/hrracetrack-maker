{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "isolatedModules": true,
    "noEmit": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/frontend", "vite.config.ts"]
}
